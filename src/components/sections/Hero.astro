---
import HeroScene from "../three/HeroScene";
---

<section id="home" class="hero-shell hero-section">
  <!-- Dynamic premium backdrop glow effects -->
  <div class="hero-bg-effects" aria-hidden="true"></div>

  <div class="hero-inner">
    <div class="hero-copy hero-text">
      <p class="hero-kicker" data-hero-eyebrow>
        <span>YATHIN G</span>
        <span class="divider">/</span>
        <span>FULL-STACK DEVELOPER</span>
        <span class="divider">/</span>
        <span>AI ENGINEERING STUDENT</span>
      </p>

      <h1 class="hero-title" data-hero-title>
        <span class="line-wrapper"><span class="line-inner">I BUILD</span></span>
        <span class="line-wrapper"><span class="line-inner">THINGS THAT</span></span>
        <span class="line-wrapper"><span class="line-inner">THINK.</span></span>
      </h1>

      <p class="hero-description" data-hero-copy>
        I design and ship AI-powered web products, experimental interfaces, and systems that turn ideas into working software.
      </p>

      <div class="hero-actions" data-hero-actions>
        <a href="#projects" class="btn btn-primary" data-magnetic>
          <span>Explore Work</span>
          <svg viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M8 3L13 8L8 13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M13 8H3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
        </a>
        <a href="#contact" class="btn btn-secondary" data-magnetic>
          <span>Contact Me</span>
        </a>
      </div>
    </div>

    <div class="hero-visual" aria-hidden="true" data-hero-visual>
      <HeroScene client:only="react" />
    </div>
  </div>

  <div class="hero-scroll-indicator">
    <span>Scroll</span>
    <div class="scroll-line" aria-hidden="true"></div>
  </div>
</section>

<style>
  .hero-shell {
    position: relative;
    min-height: 100svh;
    width: 100%;
    display: flex;
    align-items: center;
    background: var(--bg, #030305);
    overflow: hidden;
    padding: clamp(7rem, 12vh, 9rem) 1.5rem clamp(4rem, 7vh, 6rem);
    z-index: 1;
  }

  .hero-bg-effects {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background: radial-gradient(circle at 75% 30%, rgba(51, 230, 255, 0.05) 0%, transparent 55%),
                radial-gradient(circle at 25% 75%, rgba(139, 92, 246, 0.05) 0%, transparent 55%);
  }

  .hero-inner {
    position: relative;
    z-index: 2;
    width: min(1240px, 100%);
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(360px, 0.95fr);
    align-items: center;
    gap: clamp(2rem, 5vw, 5rem);
    pointer-events: none;
  }

  .hero-copy {
    position: relative;
    z-index: 4;
    display: flex;
    flex-direction: column;
    text-align: left;
    pointer-events: none;
  }

  /* Re-enable interactions for content elements */
  .hero-copy a,
  .hero-copy span,
  .hero-copy h1,
  .hero-copy p {
    pointer-events: auto;
  }

  .hero-kicker {
    display: inline-flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    color: var(--cyan, #33e6ff);
    margin-bottom: 1.2rem;
    text-transform: uppercase;
  }

  .hero-kicker .divider {
    color: var(--text-dim, #626b78);
    opacity: 0.5;
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(3.8rem, 8.5vw, 8.5rem);
    line-height: 0.84;
    letter-spacing: -0.07em;
    font-weight: 800;
    margin: 0 0 1.5rem 0;
    color: var(--text, #f5f7fb);
    text-transform: uppercase;
  }

  .line-wrapper {
    display: block;
    overflow: hidden;
    line-height: 0.9;
  }

  .line-inner {
    display: block;
    will-change: transform, opacity, filter;
  }

  /* 
    CRITICAL: 
    No static html.js opacity:0 rule is declared here.
    The text is visible by default without JS.
    GSAP immediately applies initial hidden transform and animates it on run.
  */

  .hero-description {
    font-family: var(--font-body);
    font-size: clamp(1rem, 2vw, 1.125rem);
    line-height: 1.6;
    color: var(--text-muted, #9aa4b2);
    max-width: 620px;
    margin: 0 0 2.2rem 0;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1.2rem;
  }

  /* Buttons styling matching premium aesthetics */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    padding: 0.95rem 2.2rem;
    border-radius: var(--radius-md, 16px);
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 600;
    transition: all 0.3s var(--ease-out);
    cursor: pointer;
    text-decoration: none;
  }

  .btn-primary {
    background: var(--text, #f5f7fb);
    color: #000000;
    border: 1px solid var(--text, #f5f7fb);
  }

  .btn-primary:hover {
    background: var(--cyan, #33e6ff);
    border-color: var(--cyan, #33e6ff);
    box-shadow: 0 0 25px rgba(51, 230, 255, 0.35);
    transform: translateY(-2px);
  }

  .btn-primary svg {
    width: 14px;
    height: 14px;
    transition: transform 0.3s var(--ease-out);
  }

  .btn-primary:hover svg {
    transform: translateX(4px);
  }

  .btn-secondary {
    background: rgba(255, 255, 255, 0.02);
    color: var(--text, #f5f7fb);
    border: 1px solid var(--border, rgba(255, 255, 255, 0.11));
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .btn-secondary:hover {
    background: rgba(255, 255, 255, 0.06);
    border-color: var(--border-strong, rgba(255, 255, 255, 0.2));
    transform: translateY(-2px);
  }

  .hero-visual {
    position: relative;
    height: clamp(520px, 70vh, 760px);
    min-height: 520px;
    width: 100%;
    z-index: 1;
    pointer-events: none;
    display: flex;
    align-items: center;
    justify-content: center;
    transform: translateX(-4%);
  }

  .hero-visual canvas {
    width: 100%;
    height: 100%;
  }

  .hero-visual::before {
    content: "";
    position: absolute;
    width: min(680px, 90%);
    aspect-ratio: 1;
    border-radius: 999px;
    background:
      radial-gradient(circle at center, rgba(34, 211, 238, 0.16), transparent 42%),
      radial-gradient(circle at center, rgba(139, 92, 246, 0.13), transparent 62%);
    filter: blur(34px);
    opacity: 0.9;
    pointer-events: none;
  }

  /* Scroll indicator */
  .hero-scroll-indicator {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-body);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--text-dim, #626b78);
    opacity: 0.7;
    z-index: 10;
  }

  .scroll-line {
    width: 1px;
    height: 35px;
    background: linear-gradient(to bottom, var(--text-dim, #626b78) 50%, transparent 50%);
    background-size: 100% 200%;
    animation: scroll-pulse 2.2s cubic-bezier(0.16, 1, 0.3, 1) infinite;
  }

  @keyframes scroll-pulse {
    0% {
      background-position: 0 0;
    }
    100% {
      background-position: 0 100%;
    }
  }

  /* Responsive Design */
  @media (max-width: 968px) {
    .hero-shell {
      padding: clamp(6rem, 15vh, 8rem) 1.5rem clamp(4rem, 10vh, 5rem);
    }

    .hero-inner {
      grid-template-columns: 1fr;
      gap: 2.5rem;
      pointer-events: auto;
    }

    .hero-copy {
      max-width: 100%;
    }

    .hero-title {
      font-size: clamp(3.2rem, 12vw, 5.5rem);
      margin-bottom: 1.2rem;
    }

    .hero-description {
      max-width: 100%;
      margin-bottom: 2rem;
    }

    .hero-actions {
      gap: 1rem;
    }

    .btn {
      width: 100%;
      max-width: 280px;
    }

    .hero-visual {
      height: clamp(300px, 42vh, 400px);
      min-height: 300px;
      transform: none;
    }

    .hero-scroll-indicator {
      display: none; /* Hide scroll indicator on mobile */
    }
  }

  /* Accessibility and Reduced Motion overrides */
  @media (prefers-reduced-motion: reduce) {
    .hero-title,
    .line-inner,
    .btn,
    .scroll-line {
      animation: none !important;
      transition: none !important;
      transform: none !important;
      filter: none !important;
      opacity: 1 !important;
    }
  }
</style>
