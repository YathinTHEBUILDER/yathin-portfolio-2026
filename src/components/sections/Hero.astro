---
import HeroScene from "../three/HeroScene";
---

<section id="home" class="hero-rebuild hero-section">
  <!-- Interactive 3D scene canvas loaded as client-only island to avoid SSR conflicts -->
  <div class="hero-bg" aria-hidden="true" data-hero-visual>
    <HeroScene client:only="react" />
  </div>

  <div class="container hero-container">
    <div class="hero-content hero-text">
      <p class="hero-kicker" data-hero-eyebrow>
        <span>YATHIN G</span>
        <span class="divider">/</span>
        <span>FULL-STACK DEVELOPER</span>
        <span class="divider">/</span>
        <span>AI ENGINEERING STUDENT</span>
      </p>

      <h1 class="hero-title" data-hero-title>
        <span class="line-wrapper"><span class="line-inner">I BUILD</span></span>
        <span class="line-wrapper"><span class="line-inner">THINGS THAT</span></span>
        <span class="line-wrapper"><span class="line-inner">THINK.</span></span>
      </h1>

      <p class="hero-copy" data-hero-copy>
        I design and ship AI-powered web products, experimental interfaces, and systems that turn ideas into working software.
      </p>

      <div class="hero-actions" data-hero-actions>
        <a href="#projects" class="btn btn-primary" data-magnetic>
          <span>Explore Work</span>
          <svg viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M8 3L13 8L8 13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M13 8H3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
        </a>
        <a href="#contact" class="btn btn-secondary" data-magnetic>
          <span>Contact Me</span>
        </a>
      </div>
    </div>
  </div>

  <div class="hero-scroll-indicator">
    <span>Scroll</span>
    <div class="scroll-line" aria-hidden="true"></div>
  </div>
</section>

<style>
  .hero-rebuild {
    position: relative;
    min-height: 100svh;
    width: 100%;
    display: flex;
    align-items: center;
    background: var(--bg, #030305);
    overflow: hidden;
    padding: clamp(6rem, 12vh, 10rem) 2rem clamp(4rem, 8vh, 6rem);
    z-index: 1;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .hero-container {
    width: min(1200px, 100%);
    margin: 0 auto;
    position: relative;
    z-index: 10;
    pointer-events: none;
  }

  .hero-content {
    max-width: 720px;
    display: flex;
    flex-direction: column;
    text-align: left;
    pointer-events: none;
  }

  /* Reactivate interactions on text/buttons specifically */
  .hero-content a,
  .hero-content span,
  .hero-content h1,
  .hero-content p {
    pointer-events: auto;
  }

  .hero-kicker {
    display: inline-flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    color: var(--cyan, #33e6ff);
    margin-bottom: 1.2rem;
    text-transform: uppercase;
  }

  .hero-kicker .divider {
    color: var(--text-dim, #626b78);
    opacity: 0.5;
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(3.6rem, 8.5vw, 8rem);
    line-height: 0.88;
    letter-spacing: -0.06em;
    font-weight: 800;
    margin: 0 0 1.5rem 0;
    color: var(--text, #f5f7fb);
    text-transform: uppercase;
    will-change: transform, opacity;
  }

  .line-wrapper {
    display: block;
    overflow: hidden;
    line-height: 0.9;
  }

  .line-inner {
    display: block;
    will-change: transform, opacity, filter;
  }

  /* Default hidden state for JS reveal */
  html.js .line-inner {
    transform: translateY(100%);
    opacity: 0;
    filter: blur(8px);
  }

  .hero-copy {
    font-family: var(--font-body);
    font-size: clamp(1rem, 2vw, 1.125rem);
    line-height: 1.6;
    color: var(--text-muted, #9aa4b2);
    max-width: 540px;
    margin: 0 0 2.2rem 0;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1.2rem;
  }

  /* Buttons styling matching premium aesthetics */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    padding: 0.95rem 2.2rem;
    border-radius: var(--radius-md, 16px);
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 600;
    transition: all 0.3s var(--ease-out);
    cursor: pointer;
    text-decoration: none;
  }

  .btn-primary {
    background: var(--text, #f5f7fb);
    color: #000000;
    border: 1px solid var(--text, #f5f7fb);
  }

  .btn-primary:hover {
    background: var(--cyan, #33e6ff);
    border-color: var(--cyan, #33e6ff);
    box-shadow: 0 0 25px rgba(51, 230, 255, 0.35);
    transform: translateY(-2px);
  }

  .btn-primary svg {
    width: 14px;
    height: 14px;
    transition: transform 0.3s var(--ease-out);
  }

  .btn-primary:hover svg {
    transform: translateX(4px);
  }

  .btn-secondary {
    background: rgba(255, 255, 255, 0.02);
    color: var(--text, #f5f7fb);
    border: 1px solid var(--border, rgba(255, 255, 255, 0.11));
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .btn-secondary:hover {
    background: rgba(255, 255, 255, 0.06);
    border-color: var(--border-strong, rgba(255, 255, 255, 0.2));
    transform: translateY(-2px);
  }

  /* Scroll indicator */
  .hero-scroll-indicator {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-body);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--text-dim, #626b78);
    opacity: 0.7;
    z-index: 10;
  }

  .scroll-line {
    width: 1px;
    height: 35px;
    background: linear-gradient(to bottom, var(--text-dim, #626b78) 50%, transparent 50%);
    background-size: 100% 200%;
    animation: scroll-pulse 2.2s cubic-bezier(0.16, 1, 0.3, 1) infinite;
  }

  @keyframes scroll-pulse {
    0% {
      background-position: 0 0;
    }
    100% {
      background-position: 0 100%;
    }
  }

  /* Responsive Design */
  @media (max-width: 968px) {
    .hero-rebuild {
      padding: clamp(6rem, 15vh, 8rem) 1.5rem clamp(4rem, 10vh, 5rem);
    }

    .hero-content {
      max-width: 100%;
    }

    .hero-kicker {
      margin-bottom: 0.8rem;
    }

    .hero-title {
      font-size: clamp(3.2rem, 14vw, 5.5rem);
      margin-bottom: 1.2rem;
    }

    .hero-copy {
      max-width: 100%;
      margin-bottom: 2rem;
    }

    .hero-actions {
      gap: 1rem;
    }

    .btn {
      width: 100%;
      max-width: 280px;
    }

    .hero-scroll-indicator {
      display: none; /* hide on smaller viewports for cleaner aesthetics */
    }
  }

  /* Accessibility and Reduced Motion override */
  @media (prefers-reduced-motion: reduce) {
    .hero-title,
    .line-inner,
    .btn,
    .scroll-line {
      animation: none !important;
      transition: none !important;
      transform: none !important;
      filter: none !important;
      opacity: 1 !important;
    }

    html.js .line-inner {
      transform: none !important;
      opacity: 1 !important;
      filter: none !important;
    }
  }
</style>
