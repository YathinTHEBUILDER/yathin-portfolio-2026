---
---

<section id="how-i-build" class="how-i-build-section" data-how-i-build-section>
  <div class="grid-overlay"></div>
  <div class="glow-effect"></div>

  <div class="container build-container">
    {/* Left Column: Vertical Progress Steps */}
    <div class="build-left">
      <div class="section-badge">
        <span class="badge-num">03</span>
        <span class="badge-line"></span>
        <span class="badge-title">ENGINEERING PROCESS</span>
      </div>
      <h2 class="section-headline">How I Build Systems</h2>

      <div class="steps-nav-wrapper">
        <div class="nav-vertical-line">
          <div class="nav-vertical-line-fill" data-build-line-fill></div>
        </div>
        <div class="nav-steps-list">
          <button class="nav-step-item active" data-step-nav="0" aria-label="Step 1: Problem">
            <span class="nav-step-dot"></span>
            <span class="nav-step-text">01 / Problem</span>
          </button>
          <button class="nav-step-item" data-step-nav="1" aria-label="Step 2: Research">
            <span class="nav-step-dot"></span>
            <span class="nav-step-text">02 / Research</span>
          </button>
          <button class="nav-step-item" data-step-nav="2" aria-label="Step 3: Prototype">
            <span class="nav-step-dot"></span>
            <span class="nav-step-text">03 / Prototype</span>
          </button>
          <button class="nav-step-item" data-step-nav="3" aria-label="Step 4: Architecture">
            <span class="nav-step-dot"></span>
            <span class="nav-step-text">04 / Architecture</span>
          </button>
          <button class="nav-step-item" data-step-nav="4" aria-label="Step 5: Build">
            <span class="nav-step-dot"></span>
            <span class="nav-step-text">05 / Build</span>
          </button>
          <button class="nav-step-item" data-step-nav="5" aria-label="Step 6: Ship">
            <span class="nav-step-dot"></span>
            <span class="nav-step-text">06 / Ship</span>
          </button>
          <button class="nav-step-item" data-step-nav="6" aria-label="Step 7: Iterate">
            <span class="nav-step-dot"></span>
            <span class="nav-step-text">07 / Iterate</span>
          </button>
        </div>
      </div>
    </div>

    {/* Right Column: Active Card Display (Absolute stack on desktop, vertical list on mobile) */}
    <div class="build-right">
      <div class="tech-box-frame">
        <div class="corner-mark top-left">+</div>
        <div class="corner-mark top-right">+</div>
        <div class="corner-mark bottom-left">+</div>
        <div class="corner-mark bottom-right">+</div>
        
        <div class="steps-deck">
          
          {/* Step 1: Problem */}
          <div class="step-card active" data-step-card="0">
            <div class="card-border-glow"></div>
            <div class="card-header">
              <span class="card-step-num">PHASE_01 // DEFINE</span>
              <span class="card-status-indicator active"></span>
            </div>
            <h3 class="card-step-title">01 / PROBLEM</h3>
            <h4 class="card-step-headline">Identifying bottlenecks, gaps, and human challenges.</h4>
            <p class="card-step-desc">
              Every build starts with a core friction. Whether it is MSME funding constraints in Indian financing, high voice co-processor latency, or ATS resume evaluation gaps, I define the functional constraint before writing any lines of code.
            </p>
            <div class="card-footer">
              <span class="footer-telemetry">SYS_READ :: DEFINE_ friction</span>
              <span class="footer-status text-cyan">[INITIATED]</span>
            </div>
          </div>

          {/* Step 2: Research */}
          <div class="step-card" data-step-card="1">
            <div class="card-border-glow"></div>
            <div class="card-header">
              <span class="card-step-num">PHASE_02 // EXPLORE</span>
              <span class="card-status-indicator active"></span>
            </div>
            <h3 class="card-step-title">02 / RESEARCH</h3>
            <h4 class="card-step-headline">Auditing APIs, architectures, and capabilities.</h4>
            <p class="card-step-desc">
              I audit Groq API latencies, LiveKit WebRTC channels, and Supabase security policies. I study user behavior pipelines and structural requirements, ensuring the chosen tech stack supports the performance metrics required for production.
            </p>
            <div class="card-footer">
              <span class="footer-telemetry">SYS_READ :: STACK_AUDIT_VERIFIED</span>
              <span class="footer-status text-cyan">[SEARCHING]</span>
            </div>
          </div>

          {/* Step 3: Prototype */}
          <div class="step-card" data-step-card="2">
            <div class="card-border-glow"></div>
            <div class="card-header">
              <span class="card-step-num">PHASE_03 // SANDBOX</span>
              <span class="card-status-indicator active"></span>
            </div>
            <h3 class="card-step-title">03 / PROTOTYPE</h3>
            <h4 class="card-step-headline">Validating assumptions with quick sandbox runs.</h4>
            <p class="card-step-desc">
              Proving the engineering loop. I construct small local voice handlers, basic document parses, or interactive discounted pool math modules. This guarantees that complex computational tasks remain feasible before scaling the backend.
            </p>
            <div class="card-footer">
              <span class="footer-telemetry">SYS_READ :: LOG_SANDBOX_RUNS</span>
              <span class="footer-status text-cyan">[COMPILED]</span>
            </div>
          </div>

          {/* Step 4: Architecture */}
          <div class="step-card" data-step-card="3">
            <div class="card-border-glow"></div>
            <div class="card-header">
              <span class="card-step-num">PHASE_04 // DESIGN</span>
              <span class="card-status-indicator active"></span>
            </div>
            <h3 class="card-step-title">04 / ARCHITECTURE</h3>
            <h4 class="card-step-headline">Structuring data models, security parameters, and routing.</h4>
            <p class="card-step-desc">
              Designing the system. I map database relations (Supabase/Postgres), schema structures, FastAPI router groups, local LLM context pipelines, and frontend states. Clean drawings prevent architectural debt during subsequent iterations.
            </p>
            <div class="card-footer">
              <span class="footer-telemetry">SYS_READ :: DB_RELATIONS_MAPPED</span>
              <span class="footer-status text-cyan">[MAPPED]</span>
            </div>
          </div>

          {/* Step 5: Build */}
          <div class="step-card" data-step-card="4">
            <div class="card-border-glow"></div>
            <div class="card-header">
              <span class="card-step-num">PHASE_05 // CONSTRUCT</span>
              <span class="card-status-indicator active"></span>
            </div>
            <h3 class="card-step-title">05 / BUILD</h3>
            <h4 class="card-step-headline">Writing robust code, styled layouts, and UI transitions.</h4>
            <p class="card-step-desc">
              Constructing the core engine. Building reactive components with React, wiring up custom layout transitions with GSAP and Lenis, styling with clean Vanilla CSS variables, and creating responsive pages with Astro.
            </p>
            <div class="card-footer">
              <span class="footer-telemetry">SYS_READ :: BUILD_COMPILED_CLEAN</span>
              <span class="footer-status text-cyan">[CODING]</span>
            </div>
          </div>

          {/* Step 6: Ship */}
          <div class="step-card" data-step-card="5">
            <div class="card-border-glow"></div>
            <div class="card-header">
              <span class="card-step-num">PHASE_06 // LAUNCH</span>
              <span class="card-status-indicator active"></span>
            </div>
            <h3 class="card-step-title">06 / SHIP</h3>
            <h4 class="card-step-headline">Deploying to high-performance edge hosting networks.</h4>
            <p class="card-step-desc">
              Pushing code live. Setting up CI/CD actions, configuring environment parameters, deploying API routers on performant hosting, and caching edge assets on global CDNs for minimal time-to-first-byte (TTFB).
            </p>
            <div class="card-footer">
              <span class="footer-telemetry">SYS_READ :: CDN_EDGE_ACTIVE</span>
              <span class="footer-status text-cyan">[SHIPPED]</span>
            </div>
          </div>

          {/* Step 7: Iterate */}
          <div class="step-card" data-step-card="6">
            <div class="card-border-glow"></div>
            <div class="card-header">
              <span class="card-step-num">PHASE_07 // LOOP</span>
              <span class="card-status-indicator active"></span>
            </div>
            <h3 class="card-step-title">07 / ITERATE</h3>
            <h4 class="card-step-headline">Monitoring performance logs, refining states, and polishing.</h4>
            <p class="card-step-desc">
              The continuous integration loop. Monitoring database reads, auditing user interactions, tweaking model prompt weights, lowering latency, and micro-refining styling and animations to establish premium product layouts.
            </p>
            <div class="card-footer">
              <span class="footer-telemetry">SYS_READ :: REFINING_LOOPS</span>
              <span class="footer-status text-cyan">[LOOPING]</span>
            </div>
          </div>

        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .how-i-build-section {
    position: relative;
    width: 100%;
    min-height: 100vh;
    background: #07080d;
    color: var(--text);
    overflow: hidden;
    padding: 10rem 0;
    z-index: 5;
    display: flex;
    align-items: center;
    border-top: 1px solid var(--border);
  }

  .grid-overlay {
    position: absolute;
    inset: 0;
    background-image: 
      linear-gradient(rgba(255, 255, 255, 0.012) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.012) 1px, transparent 1px);
    background-size: 50px 50px;
    background-position: center;
    pointer-events: none;
    z-index: 0;
  }

  .glow-effect {
    position: absolute;
    width: 500px;
    height: 500px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(139, 92, 246, 0.04) 0%, transparent 70%);
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    filter: blur(80px);
    pointer-events: none;
    z-index: 1;
  }

  .build-container {
    display: grid;
    grid-template-columns: 320px 1fr;
    gap: 4rem;
    width: min(1200px, calc(100% - 4rem));
    margin: 0 auto;
    z-index: 10;
    position: relative;
  }

  /* Left Column: Heading and Progress bar */
  .build-left {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    align-items: flex-start;
  }

  .section-badge {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .badge-num {
    font-family: var(--font-display);
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--cyan);
    letter-spacing: 0.05em;
  }

  .badge-line {
    width: 24px;
    height: 1px;
    background: rgba(255, 255, 255, 0.2);
  }

  .badge-title {
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--text-muted);
  }

  .section-headline {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5.5vw, 3.8rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.04em;
    color: var(--text);
    margin: 0;
  }

  /* Steps Navigation List */
  .steps-nav-wrapper {
    display: flex;
    position: relative;
    padding-left: 1.8rem;
    margin-top: 2rem;
  }

  .nav-vertical-line {
    position: absolute;
    left: 4px;
    top: 5px;
    bottom: 5px;
    width: 1px;
    background: rgba(255, 255, 255, 0.08);
  }

  .nav-vertical-line-fill {
    width: 100%;
    height: 0%;
    background: linear-gradient(to bottom, var(--cyan), var(--violet));
    transform-origin: top;
    will-change: height;
  }

  .nav-steps-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .nav-step-item {
    position: relative;
    background: transparent;
    border: none;
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0;
    color: var(--text-dim);
    font-family: monospace;
    font-size: 0.75rem;
    font-weight: bold;
    cursor: pointer;
    transition: color 0.3s var(--ease-out);
    text-align: left;
    outline: none;
  }

  .nav-step-dot {
    position: absolute;
    left: -27px;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #07080d;
    border: 1px solid rgba(255, 255, 255, 0.2);
    transition: all 0.3s var(--ease-out);
    box-shadow: none;
  }

  .nav-step-item.active {
    color: var(--text);
  }

  .nav-step-item.active .nav-step-dot {
    background: var(--cyan);
    border-color: var(--cyan);
    box-shadow: 0 0 8px var(--cyan);
    transform: scale(1.3);
  }

  .nav-step-text {
    letter-spacing: 0.05em;
  }

  /* Right Column: Steps Cards Deck */
  .build-right {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .tech-box-frame {
    position: relative;
    width: 100%;
    max-width: 520px;
    padding: 2rem;
  }

  /* Technical Annotation Marks */
  .corner-mark {
    position: absolute;
    font-family: monospace;
    font-size: 1.1rem;
    color: rgba(255, 255, 255, 0.15);
    font-weight: bold;
    pointer-events: none;
    user-select: none;
  }

  .corner-mark.top-left { top: 0; left: 0; }
  .corner-mark.top-right { top: 0; right: 0; }
  .corner-mark.bottom-left { bottom: 0; left: 0; }
  .corner-mark.bottom-right { bottom: 0; right: 0; }

  /* Steps Deck Absolute Stack */
  .steps-deck {
    position: relative;
    width: 100%;
    height: 360px;
    perspective: 1200px;
    transform-style: preserve-3d;
  }

  /* Cards Styling */
  .step-card {
    position: absolute;
    inset: 0;
    background: rgba(13, 15, 23, 0.65);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    padding: 2.2rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
    opacity: 0;
    pointer-events: none;
    transform: translateZ(-80px) translateY(12px) rotateX(4deg);
    transition: border-color 0.4s var(--ease-out), box-shadow 0.4s var(--ease-out);
  }

  .step-card.active {
    opacity: 1;
    pointer-events: auto;
    transform: translateZ(0) translateY(0) rotateX(0);
    z-index: 10;
  }

  .card-border-glow {
    position: absolute;
    top: 6px;
    left: 6px;
    right: 6px;
    bottom: 6px;
    border: 1px solid rgba(255, 255, 255, 0.03);
    border-radius: 12px;
    pointer-events: none;
  }

  .step-card:hover {
    border-color: rgba(51, 230, 255, 0.35);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.5), 0 0 15px rgba(51, 230, 255, 0.1);
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .card-step-num {
    font-family: monospace;
    font-size: 0.68rem;
    color: var(--text-dim);
    letter-spacing: 0.05em;
    font-weight: bold;
  }

  .card-status-indicator {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.15);
  }

  .card-status-indicator.active {
    background: var(--cyan);
    box-shadow: 0 0 6px var(--cyan);
  }

  .card-step-title {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 800;
    color: var(--cyan);
    letter-spacing: 0.05em;
    margin: 1rem 0 0.5rem 0;
  }

  .card-step-headline {
    font-family: var(--font-body);
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--text);
    line-height: 1.4;
    margin: 0 0 1rem 0;
    letter-spacing: -0.01em;
  }

  .card-step-desc {
    font-family: var(--font-body);
    font-size: 0.88rem;
    line-height: 1.55;
    color: var(--text-muted);
    margin: 0 0 auto 0;
  }

  .card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    padding-top: 1rem;
    margin-top: 1.5rem;
  }

  .footer-telemetry {
    font-family: monospace;
    font-size: 0.65rem;
    color: var(--text-dim);
    font-weight: bold;
  }

  .footer-status {
    font-family: monospace;
    font-size: 0.65rem;
    color: var(--cyan);
    font-weight: bold;
  }

  /* Mobile/Tablet Fallback Layout */
  @media (max-width: 968px) {
    .how-i-build-section {
      min-height: auto;
      height: auto !important;
      padding: 6rem 1.25rem;
    }

    .build-container {
      grid-template-columns: 1fr;
      gap: 3.5rem;
    }

    .steps-nav-wrapper {
      display: none; /* Hide interactive navigator on mobile */
    }

    .tech-box-frame {
      padding: 0;
      max-width: 100%;
    }

    .steps-deck {
      height: auto;
      perspective: none;
      transform-style: flat;
      display: flex;
      flex-direction: column;
      gap: 1.8rem;
    }

    .step-card {
      position: relative !important;
      inset: auto !important;
      width: 100% !important;
      height: auto !important;
      opacity: 1 !important;
      pointer-events: auto !important;
      transform: none !important;
      padding: 1.8rem;
    }

    .corner-mark {
      display: none !important;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .step-card {
      transition: none !important;
      transform: none !important;
    }
  }
</style>
