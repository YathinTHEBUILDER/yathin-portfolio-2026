---
const topologyNodes = [
  { id: "nextjs", name: "Next.js", x: 260, y: 120, group: "frontend", desc: "React framework for production grade app routing and SSR." },
  { id: "supabase", name: "Supabase", x: 190, y: 250, group: "backend", desc: "PostgreSQL DB hosting, real-time channels, and Row-Level Security." },
  { id: "sql", name: "SQL", x: 260, y: 380, group: "backend", desc: "Relational database querying, index tuning, and robust schema designs." },
  { id: "ai", name: "AI Core", x: 740, y: 120, group: "ai", desc: "Model routing, Groq Llama co-processing, and Gemini vision streams." },
  { id: "fastapi", name: "FastAPI", x: 810, y: 250, group: "backend", desc: "High-performance Python backend routing with async pipelines." },
  { id: "langchain", name: "LangChain", x: 740, y: 380, group: "ai", desc: "Context orchestration, prompt chains, and model agent logic." },
  { id: "javascript", name: "JavaScript", x: 500, y: 80, group: "languages", desc: "Dynamic script scripting, interface logic, and DOM interactions." },
  { id: "cpp", name: "C++", x: 500, y: 420, group: "languages", desc: "Underlying low-level logic, memory control, and algorithm speed." },
];
---

<section id="skills" class="skills-topology-section" data-skills-section>
  <div class="grid-overlay"></div>

  <div class="container skills-container">
    {/* Section Header */}
    <div class="section-header" data-reveal>
      <div class="section-badge">
        <span class="badge-num">05</span>
        <span class="badge-line"></span>
        <span class="badge-title">STACK TOPOLOGY</span>
      </div>
      <h2 class="section-headline">Interactive Tech Topology</h2>
      <p class="section-subtitle">Hover over any node in the network to inspect integration details.</p>
    </div>

    {/* The Interactive System Map Wrapper */}
    <div class="topology-map-wrapper" data-reveal>
      {/* SVG Network Connector Lines (Hidden on Mobile) */}
      <svg class="connection-lines" viewBox="0 0 1000 500" fill="none" preserveAspectRatio="none" aria-hidden="true">
        {topologyNodes.map((node) => (
          <path 
            class={`connection-line line-${node.id}`} 
            data-skill-line 
            d={`M 500,250 L ${node.x},${node.y}`} 
            stroke={`url(#grad-${node.group})`}
            stroke-width="1.5"
            stroke-linecap="round"
          />
        ))}

        {/* Gradient Definitions for circuit lines */}
        <defs>
          <linearGradient id="grad-frontend" x1="1" y1="1" x2="0" y2="0">
            <stop offset="0%" stop-color="var(--cyan)" stop-opacity="0.6"/>
            <stop offset="100%" stop-color="var(--blue)" stop-opacity="0.15"/>
          </linearGradient>
          <linearGradient id="grad-backend" x1="1" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="var(--cyan)" stop-opacity="0.6"/>
            <stop offset="100%" stop-color="var(--yellow)" stop-opacity="0.15"/>
          </linearGradient>
          <linearGradient id="grad-ai" x1="0" y1="1" x2="1" y2="0">
            <stop offset="0%" stop-color="var(--cyan)" stop-opacity="0.6"/>
            <stop offset="100%" stop-color="var(--violet)" stop-opacity="0.15"/>
          </linearGradient>
          <linearGradient id="grad-languages" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0%" stop-color="var(--cyan)" stop-opacity="0.6"/>
            <stop offset="100%" stop-color="var(--green)" stop-opacity="0.15"/>
          </linearGradient>
        </defs>
      </svg>

      {/* Cyber Radar / Coordinates Overlay (Hidden on Mobile) */}
      <div class="radar-bg" aria-hidden="true">
        <div class="radar-circle circle-s"></div>
        <div class="radar-circle circle-m"></div>
        <div class="radar-circle circle-l"></div>
        <div class="radar-grid-line line-h"></div>
        <div class="radar-grid-line line-v"></div>

        {/* Faint System Map Coordinates */}
        <span class="coord coord-tl">[ LAT +12.29N // LNG +76.63E ]</span>
        <span class="coord coord-tr">[ STACK_MAPPING_NODE ]</span>
        <span class="coord coord-bl">[ PROTOCOL // ENCRYPTED ]</span>
        <span class="coord coord-br">[ SYSTEM STATUS: SECURE ]</span>
      </div>

      {/* Central Core System Node: Python */}
      <div class="center-core" data-skill-center data-magnetic>
        <div class="core-glow"></div>
        <div class="core-scanner"></div>
        <div class="core-inner">
          <div class="core-subtext">CENTRAL HUB</div>
          <div class="core-text">PYTHON</div>
          <div class="core-subtext">CORE ENGINE</div>
        </div>
      </div>

      {/* Orbital Outer Nodes */}
      <div class="topology-nodes-container">
        {topologyNodes.map((node) => (
          <div 
            class={`topology-node node-${node.id} group-${node.group}`} 
            style={`left: ${node.x / 10}%; top: ${node.y / 5}%;`}
            data-skill-node={node.id}
            data-magnetic
          >
            <div class="node-glow"></div>
            <span class="node-dot"></span>
            <span class="node-label">{node.name}</span>
            
            {/* Tooltip detail description card */}
            <div class="node-tooltip">
              <span class="tooltip-group">// {node.group.toUpperCase()}</span>
              <h4 class="tooltip-title">{node.name}</h4>
              <p class="tooltip-desc">{node.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .skills-topology-section {
    position: relative;
    padding: 10rem 2rem;
    background: #030305;
    overflow: hidden;
    z-index: 1;
    border-top: 1px solid var(--border);
  }

  .grid-overlay {
    position: absolute;
    inset: 0;
    background-image: 
      linear-gradient(rgba(255, 255, 255, 0.007) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.007) 1px, transparent 1px);
    background-size: 60px 60px;
    background-position: center;
    pointer-events: none;
    z-index: -2;
  }

  .skills-container {
    width: min(1200px, calc(100% - 2rem));
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 5rem;
  }

  /* Section Header */
  .section-header {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    max-width: 680px;
    border-left: 1px solid rgba(255, 255, 255, 0.1);
    padding-left: 1.5rem;
  }

  .section-badge {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .badge-num {
    font-family: var(--font-display);
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--cyan);
    letter-spacing: 0.05em;
  }

  .badge-line {
    width: 24px;
    height: 1px;
    background: rgba(255, 255, 255, 0.2);
  }

  .badge-title {
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--text-muted);
  }

  .section-headline {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5.5vw, 3.8rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.04em;
    color: var(--text);
    margin: 0;
  }

  .section-subtitle {
    font-family: var(--font-body);
    font-size: 1rem;
    color: var(--text-muted);
    margin: 0;
    line-height: 1.5;
  }

  /* Interactive System Map Wrapper */
  .topology-map-wrapper {
    position: relative;
    width: 100%;
    max-width: 960px;
    height: 500px;
    margin: 2rem auto 0;
  }

  /* Connection lines SVG */
  .connection-lines {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 2;
  }

  .connection-line {
    fill: none;
    opacity: 0.35;
    transition: all 0.4s var(--ease-out);
  }

  /* Cyber Radar Background */
  .radar-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 1;
  }

  .radar-circle {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    border: 1px solid rgba(255, 255, 255, 0.015);
    border-radius: 50%;
  }

  .circle-s { width: 180px; height: 180px; border-color: rgba(255, 255, 255, 0.035); }
  .circle-m { width: 360px; height: 360px; border-style: dashed; }
  .circle-l { width: 560px; height: 560px; border-color: rgba(255, 255, 255, 0.01); }

  .radar-grid-line {
    position: absolute;
    background: rgba(255, 255, 255, 0.012);
  }

  .line-h {
    left: 5%;
    right: 5%;
    top: 50%;
    height: 1px;
  }

  .line-v {
    top: 5%;
    bottom: 5%;
    left: 50%;
    width: 1px;
  }

  .coord {
    position: absolute;
    font-family: monospace;
    font-size: 0.65rem;
    color: var(--text-dim);
    letter-spacing: 0.05em;
  }

  .coord-tl { top: 4%; left: 4%; }
  .coord-tr { top: 4%; right: 4%; }
  .coord-bl { bottom: 4%; left: 4%; }
  .coord-br { bottom: 4%; right: 4%; }

  /* Central Core Node */
  .center-core {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 140px;
    height: 140px;
    z-index: 10;
    cursor: pointer;
  }

  .core-inner {
    position: absolute;
    inset: 4px;
    background: rgba(7, 8, 13, 0.9);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 50%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: inset 0 0 16px rgba(255, 255, 255, 0.05), 0 12px 30px rgba(0, 0, 0, 0.5);
  }

  .core-glow {
    position: absolute;
    inset: -5px;
    border-radius: 50%;
    background: radial-gradient(circle, var(--green) 0%, transparent 70%);
    opacity: 0.45;
    filter: blur(12px);
    animation: core-glow-pulse 4s ease-in-out infinite alternate;
  }

  .core-scanner {
    position: absolute;
    inset: -1px;
    border: 1px solid var(--green);
    border-radius: 50%;
    opacity: 0.6;
    animation: core-rotate-scan 8s linear infinite;
  }

  .core-text {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 800;
    color: #fff;
    letter-spacing: 0.05em;
    margin: 4px 0;
  }

  .core-subtext {
    font-family: monospace;
    font-size: 0.55rem;
    color: var(--green);
    letter-spacing: 0.12em;
    font-weight: bold;
  }

  /* Orbital Outer Nodes Container */
  .topology-nodes-container {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 5;
  }

  .topology-node {
    position: absolute;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 0.5rem 1rem;
    background: rgba(7, 8, 13, 0.85);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    cursor: pointer;
    pointer-events: auto;
    transform: translate(-50%, -50%);
    transition: all 0.3s var(--ease-out);
  }

  .node-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--text-dim);
    transition: background 0.3s var(--ease-out);
  }

  .node-label {
    font-family: monospace;
    font-size: 0.72rem;
    font-weight: bold;
    color: var(--text-muted);
    transition: color 0.3s var(--ease-out);
  }

  /* Node hover transformations & glows */
  .topology-node:hover {
    background: rgba(13, 15, 23, 0.95);
    transform: translate(-50%, -55%);
    box-shadow: 0 10px 25px rgba(0,0,0,0.4);
    z-index: 100;
  }

  .topology-node:hover .node-label {
    color: #fff;
  }

  .node-glow {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    opacity: 0;
    pointer-events: none;
    filter: blur(8px);
    transition: opacity 0.3s var(--ease-out);
  }

  .topology-node:hover .node-glow {
    opacity: 0.15;
  }

  /* Node groups specific colors */
  .group-frontend .node-dot { background: var(--blue); }
  .group-frontend:hover { border-color: var(--blue); }
  .group-frontend .node-glow { background: var(--blue); }

  .group-backend .node-dot { background: var(--yellow); }
  .group-backend:hover { border-color: var(--yellow); }
  .group-backend .node-glow { background: var(--yellow); }

  .group-ai .node-dot { background: var(--violet); }
  .group-ai:hover { border-color: var(--violet); }
  .group-ai .node-glow { background: var(--violet); }

  .group-languages .node-dot { background: var(--cyan); }
  .group-languages:hover { border-color: var(--cyan); }
  .group-languages .node-glow { background: var(--cyan); }

  /* Tooltip detail description card */
  .node-tooltip {
    position: absolute;
    bottom: calc(100% + 12px);
    left: 50%;
    transform: translateX(-50%) translateY(8px);
    width: 200px;
    background: rgba(3, 3, 5, 0.95);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 1rem;
    box-shadow: 0 12px 30px rgba(0,0,0,0.5);
    opacity: 0;
    pointer-events: none;
    transition: all 0.3s var(--ease-out);
    z-index: 110;
    text-align: left;
    backdrop-filter: blur(12px);
  }

  .topology-node:hover .node-tooltip {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }

  .tooltip-group {
    font-family: monospace;
    font-size: 0.55rem;
    font-weight: bold;
    color: var(--text-dim);
    letter-spacing: 0.05em;
    display: block;
    margin-bottom: 0.2rem;
  }

  .tooltip-title {
    font-family: var(--font-display);
    font-size: 0.88rem;
    font-weight: 800;
    color: var(--text);
    margin: 0 0 0.4rem 0;
  }

  .tooltip-desc {
    font-family: var(--font-body);
    font-size: 0.72rem;
    line-height: 1.4;
    color: var(--text-muted);
    margin: 0;
  }

  /* Connecting lines hover highlighting triggers */
  .topology-map-wrapper:has(.node-nextjs:hover) .line-nextjs { stroke-width: 2.5; opacity: 1; stroke: var(--blue); filter: drop-shadow(0 0 4px var(--blue)); }
  .topology-map-wrapper:has(.node-supabase:hover) .line-supabase { stroke-width: 2.5; opacity: 1; stroke: var(--yellow); filter: drop-shadow(0 0 4px var(--yellow)); }
  .topology-map-wrapper:has(.node-sql:hover) .line-sql { stroke-width: 2.5; opacity: 1; stroke: var(--yellow); filter: drop-shadow(0 0 4px var(--yellow)); }
  .topology-map-wrapper:has(.node-ai:hover) .line-ai { stroke-width: 2.5; opacity: 1; stroke: var(--violet); filter: drop-shadow(0 0 4px var(--violet)); }
  .topology-map-wrapper:has(.node-fastapi:hover) .line-fastapi { stroke-width: 2.5; opacity: 1; stroke: var(--yellow); filter: drop-shadow(0 0 4px var(--yellow)); }
  .topology-map-wrapper:has(.node-langchain:hover) .line-langchain { stroke-width: 2.5; opacity: 1; stroke: var(--violet); filter: drop-shadow(0 0 4px var(--violet)); }
  .topology-map-wrapper:has(.node-javascript:hover) .line-javascript { stroke-width: 2.5; opacity: 1; stroke: var(--cyan); filter: drop-shadow(0 0 4px var(--cyan)); }
  .topology-map-wrapper:has(.node-cpp:hover) .line-cpp { stroke-width: 2.5; opacity: 1; stroke: var(--cyan); filter: drop-shadow(0 0 4px var(--cyan)); }

  @keyframes core-glow-pulse {
    0% { opacity: 0.25; transform: scale(0.92) translate(-50%, -50%); }
    100% { opacity: 0.55; transform: scale(1.1) translate(-50%, -50%); }
  }

  @keyframes core-rotate-scan {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }

  /* Mobile Layout - stack skills cleanly */
  @media (max-width: 968px) {
    .topology-map-wrapper {
      height: auto;
      margin-top: 0;
    }

    .connection-lines,
    .radar-bg,
    .center-core {
      display: none; /* Hide complex graphics and core on mobile */
    }

    .topology-nodes-container {
      position: relative;
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem;
      width: 100%;
      height: auto;
      inset: auto;
      pointer-events: auto;
    }

    .topology-node {
      position: relative !important;
      left: auto !important;
      top: auto !important;
      transform: none !important;
      justify-content: center;
      width: 100%;
      box-sizing: border-box;
      padding: 0.75rem 1rem;
    }

    .node-tooltip {
      display: none !important; /* Hide overlays on mobile screen sizes */
    }
  }

  @media (max-width: 480px) {
    .topology-nodes-container {
      grid-template-columns: 1fr;
    }
  }
</style>
