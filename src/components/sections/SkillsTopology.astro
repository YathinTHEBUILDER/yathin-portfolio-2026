---
import { skills } from "../../data/skills";

// Helper function to check if a skill is highlighted and get its highlight class
const getSkillClass = (skillName: string) => {
  const name = skillName.toLowerCase();
  if (name === "python") return "highlight-python";
  if (name === "gsap" || name === "lenis") return "highlight-motion";
  if (name === "supabase" || name === "fastapi") return "highlight-backend";
  if (name === "groq" || name === "gemini") return "highlight-ai";
  return "";
};
---

<section id="skills" class="skills-topology-section" data-skills-section>
  <div class="grid-overlay"></div>

  <div class="container skills-container">
    {/* Section Header */}
    <div class="section-header" data-reveal>
      <div class="section-badge">
        <span class="badge-num">05</span>
        <span class="badge-line"></span>
        <span class="badge-title">STACK MAP</span>
      </div>
      <h2 class="section-headline">The tools I use to turn ideas into systems.</h2>
    </div>

    {/* The Interactive System Map Wrapper */}
    <div class="topology-map-wrapper">
      {/* SVG Network Connector Lines (Hidden on Mobile) */}
      <svg class="connection-lines" viewBox="0 0 1000 600" fill="none" preserveAspectRatio="none">
        <!-- Top-Left connection to Languages -->
        <path 
          class="connection-line line-tl" 
          data-skill-line 
          d="M 500,300 L 400,300 L 320,180 L 220,180" 
          stroke="url(#grad-tl)" 
          stroke-width="1.5"
          stroke-linecap="round"
        />
        <!-- Top-Right connection to Frontend -->
        <path 
          class="connection-line line-tr" 
          data-skill-line 
          d="M 500,300 L 600,300 L 680,180 L 780,180" 
          stroke="url(#grad-tr)" 
          stroke-width="1.5"
          stroke-linecap="round"
        />
        <!-- Bottom-Left connection to Backend & Data -->
        <path 
          class="connection-line line-bl" 
          data-skill-line 
          d="M 500,300 L 400,300 L 320,420 L 220,420" 
          stroke="url(#grad-bl)" 
          stroke-width="1.5"
          stroke-linecap="round"
        />
        <!-- Bottom-Right connection to AI Experiments -->
        <path 
          class="connection-line line-br" 
          data-skill-line 
          d="M 500,300 L 600,300 L 680,420 L 780,420" 
          stroke="url(#grad-br)" 
          stroke-width="1.5"
          stroke-linecap="round"
        />

        {/* Gradient Definitions for circuit lines */}
        <defs>
          <linearGradient id="grad-tl" x1="1" y1="1" x2="0" y2="0">
            <stop offset="0%" stop-color="var(--cyan)" stop-opacity="0.6"/>
            <stop offset="100%" stop-color="var(--green)" stop-opacity="0.15"/>
          </linearGradient>
          <linearGradient id="grad-tr" x1="0" y1="1" x2="1" y2="0">
            <stop offset="0%" stop-color="var(--cyan)" stop-opacity="0.6"/>
            <stop offset="100%" stop-color="var(--blue)" stop-opacity="0.15"/>
          </linearGradient>
          <linearGradient id="grad-bl" x1="1" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="var(--cyan)" stop-opacity="0.6"/>
            <stop offset="100%" stop-color="var(--yellow)" stop-opacity="0.15"/>
          </linearGradient>
          <linearGradient id="grad-br" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0%" stop-color="var(--cyan)" stop-opacity="0.6"/>
            <stop offset="100%" stop-color="var(--violet)" stop-opacity="0.15"/>
          </linearGradient>
        </defs>
      </svg>

      {/* Cyber Radar / Coordinates Overlay (Hidden on Mobile) */}
      <div class="radar-bg">
        <div class="radar-circle circle-s"></div>
        <div class="radar-circle circle-m"></div>
        <div class="radar-circle circle-l"></div>
        <div class="radar-grid-line line-h"></div>
        <div class="radar-grid-line line-v"></div>

        {/* Faint System Map Coordinates */}
        <span class="coord coord-tl">[ LAT +45.12N // LNG -73.41W ]</span>
        <span class="coord coord-tr">[ SYS_GRID: NODE_01A ]</span>
        <span class="coord coord-bl">[ SRC: LOCALHOST:3000 ]</span>
        <span class="coord coord-br">[ STATUS: SYNCHRONIZED ]</span>
      </div>

      {/* Central Core System Node (Hidden on Mobile) */}
      <div class="center-core" data-skill-center>
        <div class="core-glow"></div>
        <div class="core-scanner"></div>
        <div class="core-inner">
          <div class="core-subtext">SYSTEM</div>
          <div class="core-text">YATHIN.G</div>
          <div class="core-subtext">CORE BUILDER</div>
        </div>
      </div>

      {/* 4 Skill quadrant Cards */}
      <div class="topology-cards-grid">
        {
          skills.map((group, index) => {
            // Map index to layout position classes
            const positionClasses = [
              "card-tl position-languages",
              "card-tr position-frontend",
              "card-bl position-backend",
              "card-br position-ai"
            ];
            
            const cardAccent = [
              "green",
              "blue",
              "yellow",
              "violet"
            ][index];

            return (
              <div 
                class={`topology-card ${positionClasses[index]} border-${cardAccent} depth-card scroll-3d-safe`}
                data-skill-group
                data-tilt-card
                data-depth-layer={index + 1}
              >
                {/* Background soft accent glow */}
                <div class={`card-inner-glow bg-glow-${cardAccent}`}></div>
                
                {/* Micro panel top dots */}
                <div class="card-panel-header">
                  <span class="panel-tag">GROUP_0{index + 1} //</span>
                  <span class="panel-title">{group.group.toUpperCase()}</span>
                </div>

                <div class="card-panel-body">
                  <h3 class="panel-headline">{group.group}</h3>
                  
                  <div class="skills-pill-box">
                    {group.items.map((item) => {
                      const highlightClass = getSkillClass(item);
                      return (
                        <span class={`skill-pill ${highlightClass}`}>
                          <span class="pill-dot"></span>
                          <span class="pill-text">{item}</span>
                        </span>
                      );
                    })}
                  </div>
                </div>
              </div>
            );
          })
        }
      </div>
    </div>
  </div>
</section>

<style>
  .skills-topology-section {
    position: relative;
    padding: 10rem 2rem;
    background: #030305;
    overflow: hidden;
    z-index: 1;
    border-top: 1px solid var(--border);
  }

  .grid-overlay {
    position: absolute;
    inset: 0;
    background-image: 
      linear-gradient(rgba(255, 255, 255, 0.007) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.007) 1px, transparent 1px);
    background-size: 60px 60px;
    background-position: center;
    pointer-events: none;
    z-index: -2;
  }

  .skills-container {
    width: min(1200px, calc(100% - 2rem));
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 6rem;
  }

  /* Section Header */
  .section-header {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    max-width: 680px;
    border-left: 1px solid rgba(255, 255, 255, 0.1);
    padding-left: 1.5rem;
  }

  .section-badge {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .badge-num {
    font-family: var(--font-display);
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--cyan);
    letter-spacing: 0.05em;
  }

  .badge-line {
    width: 24px;
    height: 1px;
    background: rgba(255, 255, 255, 0.2);
  }

  .badge-title {
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--text-muted);
  }

  .section-headline {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5.5vw, 3.8rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.04em;
    color: var(--text);
    margin: 0;
  }

  /* Interactive System Map Wrapper */
  .topology-map-wrapper {
    position: relative;
    width: 100%;
    height: 600px;
    margin-top: 2rem;
  }

  /* Connection lines SVG */
  .connection-lines {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 2;
  }

  .connection-line {
    fill: none;
  }

  /* Cyber Radar Background */
  .radar-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 1;
  }

  .radar-circle {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    border: 1px solid rgba(255, 255, 255, 0.015);
    border-radius: 50%;
  }

  .circle-s { width: 180px; height: 180px; border-color: rgba(255, 255, 255, 0.035); }
  .circle-m { width: 360px; height: 360px; border-style: dashed; }
  .circle-l { width: 560px; height: 560px; border-color: rgba(255, 255, 255, 0.01); }

  .radar-grid-line {
    position: absolute;
    background: rgba(255, 255, 255, 0.012);
  }

  .line-h {
    left: 5%;
    right: 5%;
    top: 50%;
    height: 1px;
  }

  .line-v {
    top: 5%;
    bottom: 5%;
    left: 50%;
    width: 1px;
  }

  .coord {
    position: absolute;
    font-family: monospace;
    font-size: 0.65rem;
    color: var(--text-dim);
    letter-spacing: 0.05em;
  }

  .coord-tl { top: 4%; left: 4%; }
  .coord-tr { top: 4%; right: 4%; }
  .coord-bl { bottom: 4%; left: 4%; }
  .coord-br { bottom: 4%; right: 4%; }

  /* Central Core Node */
  .center-core {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 130px;
    height: 130px;
    z-index: 10;
  }

  .core-inner {
    position: absolute;
    inset: 4px;
    background: rgba(7, 8, 13, 0.9);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 50%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: inset 0 0 16px rgba(255, 255, 255, 0.05), 0 12px 30px rgba(0, 0, 0, 0.5);
  }

  .core-glow {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: radial-gradient(circle, var(--cyan) 0%, transparent 70%);
    opacity: 0.3;
    filter: blur(8px);
    animation: core-glow-pulse 4s ease-in-out infinite alternate;
  }

  .core-scanner {
    position: absolute;
    inset: 0;
    border: 1px solid var(--cyan);
    border-radius: 50%;
    opacity: 0.4;
    animation: core-rotate-scan 8s linear infinite;
  }

  .core-text {
    font-family: var(--font-display);
    font-size: 0.85rem;
    font-weight: 800;
    color: var(--text);
    letter-spacing: 0.05em;
    margin: 2px 0;
  }

  .core-subtext {
    font-family: monospace;
    font-size: 0.52rem;
    color: var(--cyan);
    letter-spacing: 0.12em;
    font-weight: bold;
  }

  @keyframes core-glow-pulse {
    0% { opacity: 0.15; transform: scale(0.9); }
    100% { opacity: 0.4; transform: scale(1.15); }
  }

  @keyframes core-rotate-scan {
    0% { transform: rotate(0deg); border-color: var(--cyan); }
    50% { border-color: var(--blue); }
    100% { transform: rotate(360deg); border-color: var(--cyan); }
  }

  /* Quad cards wrapper grid */
  .topology-cards-grid {
    position: relative;
    width: 100%;
    height: 100%;
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: 1fr 1fr;
    gap: 15rem 24rem; /* Lots of space in the middle for center-core! */
    z-index: 5;
  }

  /* Topology Panels */
  .topology-card {
    position: relative;
    background: rgba(7, 8, 13, 0.45);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    padding: 1.8rem;
    display: flex;
    flex-direction: column;
    transition: all 0.4s var(--ease-out);
    overflow: hidden;
  }

  .topology-card::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    width: 2px;
    background: transparent;
  }

  .topology-card:hover {
    background: rgba(7, 8, 13, 0.6);
    transform: translateY(-2px);
  }

  /* Hover accent-glow setups */
  .border-green:hover { border-color: rgba(61, 217, 160, 0.35); box-shadow: 0 10px 30px -15px rgba(61, 217, 160, 0.12); }
  .border-blue:hover { border-color: rgba(79, 124, 255, 0.35); box-shadow: 0 10px 30px -15px rgba(79, 124, 255, 0.12); }
  .border-yellow:hover { border-color: rgba(255, 209, 102, 0.35); box-shadow: 0 10px 30px -15px rgba(255, 209, 102, 0.12); }
  .border-violet:hover { border-color: rgba(139, 92, 246, 0.35); box-shadow: 0 10px 30px -15px rgba(139, 92, 246, 0.12); }

  .border-green::before { left: 0; background: var(--green); }
  .border-blue::before { left: 0; background: var(--blue); }
  .border-yellow::before { left: 0; background: var(--yellow); }
  .border-violet::before { left: 0; background: var(--violet); }

  /* Soft card background glows */
  .card-inner-glow {
    position: absolute;
    width: 200px;
    height: 200px;
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.04;
    pointer-events: none;
    z-index: -1;
    transition: opacity 0.4s var(--ease-out);
  }

  .topology-card:hover .card-inner-glow {
    opacity: 0.08;
  }

  .bg-glow-green { background: var(--green); top: -10%; left: -10%; }
  .bg-glow-blue { background: var(--blue); top: -10%; right: -10%; }
  .bg-glow-yellow { background: var(--yellow); bottom: -10%; left: -10%; }
  .bg-glow-violet { background: var(--violet); bottom: -10%; right: -10%; }

  /* Panel Header styles */
  .card-panel-header {
    display: flex;
    align-items: center;
    gap: 6px;
    font-family: monospace;
    font-size: 0.65rem;
    color: var(--text-dim);
    letter-spacing: 0.05em;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    padding-bottom: 0.6rem;
    margin-bottom: 1rem;
  }

  .panel-title {
    font-weight: bold;
    color: var(--text-muted);
  }

  .panel-headline {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 800;
    color: var(--text);
    margin: 0 0 1.2rem 0;
    letter-spacing: -0.01em;
  }

  /* Skill Pills Box */
  .skills-pill-box {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .skill-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: monospace;
    font-size: 0.72rem;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--border);
    padding: 0.4rem 0.8rem;
    border-radius: 99px;
    color: var(--text-muted);
    transition: all 0.3s var(--ease-out);
  }

  .pill-dot {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--text-dim);
    display: inline-block;
    transition: background 0.3s var(--ease-out);
  }

  .topology-card:hover .skill-pill {
    border-color: var(--border-strong);
    color: var(--text);
  }

  /* Skill specific highlights */
  /* Python - visually strongest, custom green border glow */
  .highlight-python {
    background: rgba(61, 217, 160, 0.06) !important;
    border-color: rgba(61, 217, 160, 0.3) !important;
    color: var(--text) !important;
    box-shadow: 0 0 15px rgba(61, 217, 160, 0.15);
    font-weight: bold;
  }
  .highlight-python .pill-dot {
    background: var(--green) !important;
    box-shadow: 0 0 6px var(--green);
  }

  /* GSAP / Lenis - Motion cyan */
  .highlight-motion {
    background: rgba(51, 230, 255, 0.06) !important;
    border-color: rgba(51, 230, 255, 0.3) !important;
    color: var(--cyan) !important;
  }
  .highlight-motion .pill-dot {
    background: var(--cyan) !important;
    box-shadow: 0 0 6px var(--cyan);
  }

  /* Backend Highlights (Supabase / FastAPI) */
  .highlight-backend {
    background: rgba(255, 209, 102, 0.06) !important;
    border-color: rgba(255, 209, 102, 0.3) !important;
    color: var(--yellow) !important;
  }
  .highlight-backend .pill-dot {
    background: var(--yellow) !important;
    box-shadow: 0 0 6px var(--yellow);
  }

  /* AI/Experiments Highlights (Groq / Gemini) */
  .highlight-ai {
    background: rgba(139, 92, 246, 0.06) !important;
    border-color: rgba(139, 92, 246, 0.3) !important;
    color: var(--violet) !important;
  }
  .highlight-ai .pill-dot {
    background: var(--violet) !important;
    box-shadow: 0 0 6px var(--violet);
  }

  /* Desktop layout placement tweaks */
  .position-languages { align-self: flex-start; justify-self: flex-start; }
  .position-frontend { align-self: flex-start; justify-self: flex-end; }
  .position-backend { align-self: flex-end; justify-self: flex-start; }
  .position-ai { align-self: flex-end; justify-self: flex-end; }

  /* Mobile/Tablet Fallback Layout */
  @media (max-width: 968px) {
    .topology-map-wrapper {
      height: auto;
      margin-top: 0;
    }

    .connection-lines,
    .radar-bg,
    .center-core {
      display: none; /* Hide svg graphics and orbital core on mobile */
    }

    .topology-cards-grid {
      grid-template-columns: 1fr;
      grid-template-rows: auto;
      gap: 2rem;
      height: auto;
    }

    .topology-card {
      align-self: stretch !important;
      justify-self: stretch !important;
    }
  }

  /* Support prefers reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .core-scanner,
    .core-glow {
      animation: none;
    }
    .topology-card:hover {
      transform: none !important;
    }
    .skill-pill {
      transition: none !important;
    }
  }
</style>
