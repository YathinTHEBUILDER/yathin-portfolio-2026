---
import { projects } from "../../data/projects";

// Filter only non-featured projects (J.A.R.V.I.S and F.R.I.D.A.Y)
const experimentalProjects = projects.filter((p) => !p.featured);
---

<section id="experiments" class="experiments-section" data-experiment-section>
  <div class="grid-overlay"></div>

  <div class="container experiments-container">
    {/* Section Header */}
    <div class="section-header" data-reveal>
      <div class="section-badge">
        <span class="badge-num">04</span>
        <span class="badge-line"></span>
        <span class="badge-title">AI EXPERIMENTS</span>
      </div>
      <h2 class="section-headline">Systems built to explore voice, vision, automation, and realtime AI.</h2>
    </div>

    {/* Cards Grid */}
    <div class="experiments-grid perspective-scene scroll-3d-safe">
      {
        experimentalProjects.map((proj) => {
          // Setup logs depending on system
          const logs = proj.slug === "sortmyskills" 
            ? [
                { command: "parse.resume()", response: "92% MATCH // OK" },
                { command: "assess.gaps()", response: "3 STACK_GAPS" },
                { command: "roadmap.generate()", response: "COMPILED" }
              ]
            : proj.slug === "jarvis"
            ? [
                { command: "wake.signal()", response: "ACTIVE // OK" },
                { command: "search.live()", response: "LATENCY < 45MS" },
                { command: "respond.fast()", response: "PIPELINE LOADED" }
              ]
            : [
                { command: "vision.stream()", response: "FEED CONNECTED" },
                { command: "audio.listen()", response: "MIC ACTIVE // HZ" },
                { command: "context.reason()", response: "CONTEXT RESOLVED" }
              ];

          return (
            <div class="experiment-card-wrapper depth-card" data-experiment-card>
              {/* Dynamic Glow behind card */}
              <div class={`card-glow glow-${proj.accent}`}></div>

              {/* Layer 1: Transparent Rear Depth Slab */}
              <div class="experiment-depth-slab depth-card" data-experiment-depth-slab></div>

              {/* Layer 2: Floating Diagnostic Chips */}
              <div class="diagnostic-chip chip-tl">[ SYS_LOG::{proj.slug.toUpperCase()} ]</div>
              <div class="diagnostic-chip chip-tr">[ LATENCY::{proj.accent === "yellow" ? "<45MS" : "<40MS"} ]</div>
              <div class="diagnostic-chip chip-bl">[ SIGNAL::ACTIVE ]</div>
              <div class="diagnostic-chip chip-br">[ STATUS::LIVE ]</div>

              {/* Layer 3: Main AI Lab Monitor Card */}
              <div class={`experiment-card border-${proj.accent} depth-card`} data-tilt-card>
                {/* Scanning line overlay */}
                <div class="scanline"></div>

                {/* Top Terminal Header */}
                <div class="card-header">
                  <div class="window-controls">
                    <span class="dot dot-close"></span>
                    <span class="dot dot-minimize"></span>
                    <span class="dot dot-maximize"></span>
                  </div>
                  <div class="header-path">
                    sys@yathin:~/{proj.slug}.config
                  </div>
                  <div class="header-status">
                    <span class={`status-indicator indicator-${proj.accent}`}></span>
                    <span>LIVE</span>
                  </div>
                </div>

                {/* Left vertical accent and Card body */}
                <div class="card-body">
                  {/* Floating Technical Vision Grid Motif */}
                  <div class="vision-grid">
                    <svg viewBox="0 0 40 40" fill="none" class="vision-grid-svg" aria-hidden="true">
                      <rect width="40" height="40" stroke="rgba(255, 255, 255, 0.05)" stroke-width="0.5" />
                      <line x1="10" y1="0" x2="10" y2="40" stroke="rgba(255, 255, 255, 0.03)" stroke-width="0.5" />
                      <line x1="20" y1="0" x2="20" y2="40" stroke="rgba(255, 255, 255, 0.03)" stroke-width="0.5" />
                      <line x1="30" y1="0" x2="30" y2="40" stroke="rgba(255, 255, 255, 0.03)" stroke-width="0.5" />
                      <line x1="0" y1="10" x2="40" y2="10" stroke="rgba(255, 255, 255, 0.03)" stroke-width="0.5" />
                      <line x1="0" y1="20" x2="40" y2="20" stroke="rgba(255, 255, 255, 0.03)" stroke-width="0.5" />
                      <line x1="0" y1="30" x2="40" y2="30" stroke="rgba(255, 255, 255, 0.03)" stroke-width="0.5" />
                      <circle cx="20" cy="20" r="12" stroke={`var(--${proj.accent})`} stroke-width="0.5" stroke-dasharray="2 2" opacity="0.35" class="scanner-circle" />
                    </svg>
                  </div>

                  <div class="card-meta">
                    <span class={`card-type text-${proj.accent}`}>{proj.type}</span>
                    <span class="meta-divider">|</span>
                    <span class="card-status">{proj.status}</span>
                  </div>

                  <h3 class="card-title">{proj.name}</h3>
                  <p class="card-headline">{proj.headline}</p>
                  <p class="card-desc">{proj.description}</p>

                  {/* Terminal Diagnostic Panel */}
                  <div class="diagnostic-panel">
                    <div class="terminal-info">
                      <span>SYSTEM DIAGNOSTIC REPORT v4.2.0</span>
                      <span class="terminal-time">SYS_TIME // SECURE</span>
                    </div>

                    <div class="terminal-logs">
                      <div class="terminal-log-line" data-terminal-line>
                        <span class="log-prompt">$</span>
                        <span class="log-cmd">init.system()</span>
                        <span class="log-res text-dim">CORE_INIT_OK</span>
                      </div>
                      
                      {logs.map((log) => (
                        <div class="terminal-log-line" data-terminal-line>
                          <span class="log-prompt">$</span>
                          <span class="log-cmd">{log.command}</span>
                          <span class={`log-res text-${proj.accent}`}>{log.response}</span>
                        </div>
                      ))}

                      <div class="terminal-log-line" data-terminal-line>
                        <span class="log-prompt">$</span>
                        <span class="log-cmd">status.check()</span>
                        <span class="log-res blink-text">SYS_STANDBY</span>
                      </div>
                    </div>

                    {/* Audio Waveform / Signal Equalizer */}
                    <div class="waveform-container">
                      <div class="waveform-label">SIGNAL STRENGTH</div>
                      <div class="waveform-bars">
                        <span class={`bar bar-1 bg-${proj.accent}`}></span>
                        <span class={`bar bar-2 bg-${proj.accent}`}></span>
                        <span class={`bar bar-3 bg-${proj.accent}`}></span>
                        <span class={`bar bar-4 bg-${proj.accent}`}></span>
                        <span class={`bar bar-5 bg-${proj.accent}`}></span>
                        <span class={`bar bar-6 bg-${proj.accent}`}></span>
                        <span class={`bar bar-7 bg-${proj.accent}`}></span>
                      </div>
                    </div>
                  </div>

                  {/* Stack Badges */}
                  <div class="card-stack">
                    {proj.stack.map((tech) => (
                      <span class="stack-badge">{tech}</span>
                    ))}
                  </div>

                  {/* Actions */}
                  {proj.github && (
                    <div class="card-actions">
                      <a 
                        href={proj.github}
                        target="_blank"
                        rel="noreferrer"
                        class="btn-repo"
                      >
                        <svg viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" class="github-icon">
                          <path d="M8 0C3.58 0 0 3.58 0 8C0 11.54 2.29 14.53 5.47 15.59C5.87 15.66 6.02 15.42 6.02 15.21C6.02 15.02 6.01 14.39 6.01 13.72C4 14.09 3.48 13.23 3.32 12.78C3.23 12.55 2.84 11.84 2.5 11.65C2.22 11.5 1.82 11.13 2.49 11.12C3.12 11.11 3.57 11.7 3.72 11.94C4.44 13.15 5.59 12.81 6.05 12.6C6.12 12.08 6.33 11.73 6.56 11.53C4.78 11.33 2.92 10.64 2.92 7.58C2.92 6.71 3.23 5.99 3.74 5.43C3.66 5.23 3.38 4.41 3.82 3.31C3.82 3.31 4.49 3.1 6.02 4.13C6.66 3.95 7.34 3.86 8.02 3.86C8.7 3.86 9.38 3.95 10.02 4.13C11.55 3.09 12.22 3.31 12.22 3.31C12.66 4.41 12.38 5.23 12.3 5.43C12.81 5.99 13.12 6.7 13.12 7.58C13.12 10.65 11.25 11.33 9.47 11.53C9.76 11.78 10.01 12.26 10.01 13.01C10.01 14.08 10 14.94 10 15.21C10 15.42 10.15 15.67 10.55 15.59C13.71 14.53 16 11.53 16 8C16 3.58 12.42 0 8 0Z" fill="currentColor"/>
                        </svg>
                        <span>Access Codebase</span>
                      </a>
                    </div>
                  )}
                </div>
              </div>
            </div>
          );
        })
      }
    </div>
  </div>
</section>

<style>
  .experiments-section {
    position: relative;
    padding: 10rem 2rem;
    background: #030305;
    overflow: hidden;
    z-index: 1;
    border-top: 1px solid var(--border);
  }

  .grid-overlay {
    position: absolute;
    inset: 0;
    background-image: 
      linear-gradient(rgba(255, 255, 255, 0.007) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.007) 1px, transparent 1px);
    background-size: 50px 50px;
    background-position: center;
    pointer-events: none;
    z-index: -2;
  }

  .experiments-container {
    width: min(1200px, calc(100% - 2rem));
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 6rem;
  }

  /* Section Header */
  .section-header {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    max-width: 680px;
    border-left: 1px solid rgba(255, 255, 255, 0.1);
    padding-left: 1.5rem;
  }

  .section-badge {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .badge-num {
    font-family: var(--font-display);
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--cyan);
    letter-spacing: 0.05em;
  }

  .badge-line {
    width: 24px;
    height: 1px;
    background: rgba(255, 255, 255, 0.2);
  }

  .badge-title {
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--text-muted);
  }

  .section-headline {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5.5vw, 3.8rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.04em;
    color: var(--text);
    margin: 0;
  }

  /* Experiments Grid */
  .experiments-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3.5rem;
    perspective: 1400px;
    transform-style: preserve-3d;
  }

  @media (max-width: 968px) {
    .experiments-grid {
      grid-template-columns: 1fr;
      gap: 4rem;
    }
  }

  /* Experiment Card Wrapper & Background Glows */
  .experiment-card-wrapper {
    position: relative;
    width: 100%;
    transform-style: preserve-3d;
    backface-visibility: hidden;
  }

  /* Rear transparent depth slab styling */
  .experiment-depth-slab {
    position: absolute;
    inset: -10px;
    border-radius: var(--radius-md);
    border: 1px dashed rgba(255, 255, 255, 0.05);
    background: rgba(255, 255, 255, 0.003);
    z-index: 1;
    pointer-events: none;
    transform: translateZ(-35px);
    transition: border-color 0.4s var(--ease-out);
  }
  .experiment-card-wrapper:hover .experiment-depth-slab {
    border-color: rgba(255, 255, 255, 0.1);
  }

  /* Diagnostic coordinate labels */
  .diagnostic-chip {
    position: absolute;
    font-family: monospace;
    font-size: 0.6rem;
    font-weight: bold;
    color: var(--text-dim);
    opacity: 0.25;
    z-index: 10;
    pointer-events: none;
    letter-spacing: 0.05em;
  }

  .chip-tl {
    top: -15px;
    left: 10px;
  }

  .chip-tr {
    top: -15px;
    right: 10px;
  }

  .chip-bl {
    bottom: -15px;
    left: 10px;
  }

  .chip-br {
    bottom: -15px;
    right: 10px;
  }

  .card-glow {
    position: absolute;
    width: 320px;
    height: 320px;
    border-radius: 50%;
    filter: blur(100px);
    opacity: 0.12;
    pointer-events: none;
    z-index: -1;
    transition: opacity 0.5s var(--ease-out), transform 0.5s var(--ease-out);
  }

  .glow-yellow {
    background: radial-gradient(circle, var(--yellow) 0%, transparent 70%);
    top: 10%;
    left: 10%;
  }

  .glow-violet {
    background: radial-gradient(circle, var(--violet) 0%, transparent 70%);
    bottom: 10%;
    right: 10%;
  }

  .experiment-card-wrapper:hover .card-glow {
    opacity: 0.22;
    transform: scale(1.15);
  }

  /* Experiment Card Layout */
  .experiment-card {
    position: relative;
    background: rgba(7, 8, 13, 0.5);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: all 0.4s var(--ease-out);
    height: 100%;
    z-index: 5;
  }

  .experiment-card::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 4px;
    background: var(--border);
    transition: background 0.4s var(--ease-out);
  }

  /* Border Accents on hover / specific items */
  .border-yellow:hover {
    border-color: rgba(255, 209, 102, 0.35);
    box-shadow: 0 10px 40px -15px rgba(255, 209, 102, 0.15);
    transform: translateY(-4px);
    background: rgba(7, 8, 13, 0.6);
  }

  .border-violet:hover {
    border-color: rgba(139, 92, 246, 0.35);
    box-shadow: 0 10px 40px -15px rgba(139, 92, 246, 0.15);
    transform: translateY(-4px);
    background: rgba(7, 8, 13, 0.6);
  }

  .border-yellow::before {
    background: linear-gradient(180deg, var(--yellow), rgba(255, 209, 102, 0.2));
  }

  .border-violet::before {
    background: linear-gradient(180deg, var(--violet), rgba(139, 92, 246, 0.2));
  }

  /* Scanning Line Animation */
  .scanline {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      to bottom,
      rgba(255, 255, 255, 0),
      rgba(255, 255, 255, 0) 50%,
      rgba(255, 255, 255, 0.015) 50%,
      rgba(255, 255, 255, 0.015)
    );
    background-size: 100% 4px;
    z-index: 5;
    pointer-events: none;
  }

  .scanline::after {
    content: '';
    position: absolute;
    left: 0;
    top: -10%;
    width: 100%;
    height: 10%;
    background: linear-gradient(
      to bottom,
      rgba(255, 255, 255, 0),
      rgba(255, 255, 255, 0.04) 50%,
      rgba(255, 255, 255, 0)
    );
    animation: scan 6s linear infinite;
  }

  @keyframes scan {
    0% {
      top: -10%;
    }
    100% {
      top: 110%;
    }
  }

  /* Card Header styles */
  .card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1.5rem;
    border-bottom: 1px solid var(--border);
    background: rgba(255, 255, 255, 0.02);
  }

  .window-controls {
    display: flex;
    gap: 6px;
  }

  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.15);
  }

  .dot-close { background: rgba(239, 68, 68, 0.6); }
  .dot-minimize { background: rgba(245, 158, 11, 0.6); }
  .dot-maximize { background: rgba(16, 185, 129, 0.6); }

  .header-path {
    font-family: monospace;
    font-size: 0.7rem;
    color: var(--text-dim);
    letter-spacing: 0.05em;
  }

  .header-status {
    display: flex;
    align-items: center;
    gap: 6px;
    font-family: monospace;
    font-size: 0.7rem;
    color: var(--text-muted);
    font-weight: bold;
  }

  .status-indicator {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    display: inline-block;
  }

  .indicator-yellow {
    background: var(--yellow);
    box-shadow: 0 0 8px var(--yellow);
    animation: pulse 1.8s infinite;
  }

  .indicator-violet {
    background: var(--violet);
    box-shadow: 0 0 8px var(--violet);
    animation: pulse 1.8s infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 0.5; }
    50% { opacity: 1; }
  }

  .vision-grid {
    position: absolute;
    top: 2.2rem;
    right: 2.2rem;
    width: 60px;
    height: 60px;
    pointer-events: none;
    z-index: 0;
  }

  .vision-grid-svg {
    width: 100%;
    height: 100%;
  }

  .scanner-circle {
    transform-origin: center;
    animation: core-rotate-scan 10s linear infinite;
  }

  /* Card Body */
  .card-body {
    position: relative;
    padding: 2.2rem 2.2rem 2.2rem 2.5rem;
    flex-grow: 1;
    display: flex;
    flex-direction: column;
  }

  .card-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    margin-bottom: 0.8rem;
  }

  .card-type {
    text-transform: uppercase;
  }

  .text-yellow { color: var(--yellow); }
  .text-violet { color: var(--violet); }

  .meta-divider {
    color: rgba(255, 255, 255, 0.1);
  }

  .card-status {
    color: var(--text-dim);
    text-transform: uppercase;
  }

  .card-title {
    font-family: var(--font-display);
    font-size: 1.8rem;
    font-weight: 800;
    margin: 0 0 0.8rem 0;
    color: var(--text);
    letter-spacing: -0.02em;
  }

  .card-headline {
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.4;
    color: var(--text);
    margin: 0 0 1rem 0;
  }

  .card-desc {
    font-family: var(--font-body);
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--text-muted);
    margin: 0 0 2rem 0;
  }

  /* Terminal Diagnostic Panel */
  .diagnostic-panel {
    font-family: monospace;
    font-size: 0.75rem;
    background: rgba(3, 3, 5, 0.8);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 1.2rem;
    margin-bottom: 2.2rem;
    position: relative;
  }

  .terminal-info {
    display: flex;
    justify-content: space-between;
    color: var(--text-dim);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    padding-bottom: 0.6rem;
    margin-bottom: 0.8rem;
    font-size: 0.68rem;
    letter-spacing: 0.05em;
  }

  .terminal-logs {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    margin-bottom: 1.2rem;
  }

  .terminal-log-line {
    display: flex;
    gap: 8px;
  }

  .log-prompt {
    color: var(--cyan);
    user-select: none;
  }

  .log-cmd {
    color: var(--text);
  }

  .log-res {
    margin-left: auto;
    font-weight: 600;
  }

  .text-dim {
    color: var(--text-dim);
  }

  .blink-text {
    animation: text-blink 1.2s infinite;
  }

  @keyframes text-blink {
    0%, 100% { opacity: 0.4; }
    50% { opacity: 1; }
  }

  /* Waveform / Equalizer Visuals */
  .waveform-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    padding-top: 0.8rem;
  }

  .waveform-label {
    font-size: 0.65rem;
    color: var(--text-dim);
    letter-spacing: 0.05em;
  }

  .waveform-bars {
    display: flex;
    align-items: flex-end;
    gap: 3px;
    height: 16px;
  }

  .bar {
    width: 2px;
    height: 4px;
    border-radius: 1px;
    display: inline-block;
  }

  /* Dynamic CSS animations for bars */
  .bg-yellow { background: var(--yellow); }
  .bg-violet { background: var(--violet); }

  .bar-1 { animation: sound-bounce 0.8s ease-in-out infinite alternate; }
  .bar-2 { animation: sound-bounce 1.1s ease-in-out infinite alternate; animation-delay: 0.2s; }
  .bar-3 { animation: sound-bounce 0.9s ease-in-out infinite alternate; animation-delay: 0.1s; }
  .bar-4 { animation: sound-bounce 1.3s ease-in-out infinite alternate; animation-delay: 0.4s; }
  .bar-5 { animation: sound-bounce 0.7s ease-in-out infinite alternate; animation-delay: 0.3s; }
  .bar-6 { animation: sound-bounce 1.0s ease-in-out infinite alternate; animation-delay: 0.15s; }
  .bar-7 { animation: sound-bounce 0.9s ease-in-out infinite alternate; animation-delay: 0.25s; }

  @keyframes sound-bounce {
    0% { height: 3px; }
    100% { height: 16px; }
  }

  /* Stack tags */
  .card-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 2rem;
    margin-top: auto; /* Push tags/buttons to the bottom */
  }

  .stack-badge {
    font-family: monospace;
    font-size: 0.75rem;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--border);
    padding: 0.3rem 0.7rem;
    border-radius: 99px;
    color: var(--text-muted);
    transition: all 0.3s var(--ease-out);
  }

  .experiment-card:hover .stack-badge {
    color: var(--text);
    border-color: var(--border-strong);
    background: rgba(255, 255, 255, 0.06);
  }

  /* Button link to codebase */
  .card-actions {
    display: flex;
  }

  .btn-repo {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    width: 100%;
    padding: 0.85rem;
    border-radius: var(--radius-md);
    font-family: var(--font-body);
    font-size: 0.85rem;
    font-weight: 600;
    background: rgba(255, 255, 255, 0.03);
    color: var(--text);
    border: 1px solid var(--border);
    transition: all 0.3s var(--ease-out);
    cursor: pointer;
  }

  .btn-repo:hover {
