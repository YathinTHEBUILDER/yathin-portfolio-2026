---
import { profile } from "../../data/profile";
---

<section id="about" class="about-section" data-about-section>
  <div class="grid-overlay"></div>
  <div class="about-glow"></div>

  <div class="container about-container">
    {/* Section Header */}
    <div class="about-header" data-reveal>
      <div class="section-badge">
        <span class="badge-num">02</span>
        <span class="badge-line"></span>
        <span class="badge-title">BUILDER PROFILE</span>
      </div>
      <h2 class="section-headline">Who I am & How I construct systems.</h2>
    </div>

    {/* 4-Block Visual Grid */}
    <div class="about-grid perspective-scene scroll-3d-safe" data-reveal>
      
      {/* Block 1: Who I Am */}
      <div class="about-block block-who depth-card" data-tilt-card>
        <div class="block-glow"></div>
        <div class="block-border-accent"></div>
        <span class="block-tag">// NODE_01 :: PROFILE</span>
        <h3 class="block-title">WHO I AM</h3>
        <div class="profile-bullets">
          <div class="bullet-item">
            <span class="bullet-dot"></span>
            <span class="bullet-text"><strong>Yathin G</strong> — AI Product Builder & CSE Student based in Mysuru, India.</span>
          </div>
          <div class="bullet-item">
            <span class="bullet-dot"></span>
            <span class="bullet-text">Designing high-performance web products, local co-processors, and low-latency audio/video streams.</span>
          </div>
          <div class="bullet-item">
            <span class="bullet-dot"></span>
            <span class="bullet-text">Focused on bridging human intentions with clean computational logic.</span>
          </div>
        </div>
      </div>

      {/* Block 2: How I Think */}
      <div class="about-block block-think depth-card" data-tilt-card>
        <div class="block-glow"></div>
        <div class="block-border-accent"></div>
        <span class="block-tag">// NODE_02 :: ETHOS</span>
        <h3 class="block-title">HOW I THINK</h3>
        <div class="quote-wrapper">
          <p class="quote-text">
            “I don't wait to be ready.<br/>I build until I am.”
          </p>
        </div>
        <div class="principles-list">
          <span class="principle-tag">Scale Systems</span>
          <span class="principle-tag">Clean Architecture</span>
          <span class="principle-tag">Zero Latency</span>
        </div>
      </div>

      {/* Block 3: What I Build */}
      <div class="about-block block-build depth-card" data-tilt-card>
        <div class="block-glow"></div>
        <div class="block-border-accent"></div>
        <span class="block-tag">// NODE_03 :: TELEMETRY</span>
        <h3 class="block-title">WHAT I BUILD</h3>
        
        {/* Monospace Telemetry Readout Box */}
        <div class="telemetry-box">
          <div class="telemetry-row">
            <span class="t-label">OPERATOR:</span>
            <span class="t-value">YATHIN_G // ADMIN</span>
          </div>
          <div class="telemetry-row">
            <span class="t-label">LOCATION:</span>
            <span class="t-value">{profile.location.toUpperCase()}</span>
          </div>
          <div class="telemetry-row">
            <span class="t-label">ACTIVE_STATUS:</span>
            <span class="t-value text-cyan">OK // COMPILING</span>
          </div>
          <div class="telemetry-row">
            <span class="t-label">ENGINE:</span>
            <span class="t-value text-green">ASTRO v6.4 // VITE</span>
          </div>
          <div class="telemetry-row">
            <span class="t-label">SYSTEM_LATENCY:</span>
            <span class="t-value text-violet">STABLE_60_FPS</span>
          </div>
        </div>
      </div>

      {/* Block 4: Future Vision */}
      <div class="about-block block-vision depth-card" data-tilt-card>
        <div class="block-glow"></div>
        <div class="block-border-accent"></div>
        <span class="block-tag">// NODE_04 :: FOCUS</span>
        <h3 class="block-title">FUTURE VISION</h3>
        <div class="vision-grid-list">
          <div class="vision-item">
            <span class="vision-num">01</span>
            <div>
              <h4 class="vision-title">Local LLM Orchestration</h4>
              <p class="vision-desc">Running lightweight model loops locally with near-zero network roundtrips.</p>
            </div>
          </div>
          <div class="vision-item">
            <span class="vision-num">02</span>
            <div>
              <h4 class="vision-title">Spatial Multimodal AI</h4>
              <p class="vision-desc">Developing vision co-processors parsing environments over real-time WebRTC streams.</p>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  .about-section {
    position: relative;
    padding: 10rem 2rem;
    background: #030305;
    overflow: hidden;
    z-index: 1;
    border-top: 1px solid var(--border);
  }

  .grid-overlay {
    position: absolute;
    inset: 0;
    background-image: 
      linear-gradient(rgba(255, 255, 255, 0.007) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.007) 1px, transparent 1px);
    background-size: 50px 50px;
    background-position: center;
    pointer-events: none;
    z-index: -2;
  }

  .about-glow {
    position: absolute;
    width: 600px;
    height: 600px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(139, 92, 246, 0.04) 0%, transparent 70%);
    top: 30%;
    right: 5%;
    pointer-events: none;
    z-index: -1;
  }

  .about-container {
    width: min(1200px, calc(100% - 2rem));
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 5rem;
  }

  /* Section Header */
  .about-header {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    max-width: 680px;
    border-left: 1px solid rgba(255, 255, 255, 0.1);
    padding-left: 1.5rem;
  }

  .section-badge {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .badge-num {
    font-family: var(--font-display);
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--cyan);
    letter-spacing: 0.05em;
  }

  .badge-line {
    width: 24px;
    height: 1px;
    background: rgba(255, 255, 255, 0.2);
  }

  .badge-title {
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--text-muted);
  }

  .section-headline {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5.5vw, 3.8rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.04em;
    color: var(--text);
    margin: 0;
  }

  /* 4-Block Visual Grid */
  .about-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2.2rem;
    perspective: 1400px;
    transform-style: preserve-3d;
  }

  .about-block {
    position: relative;
    background: rgba(13, 15, 23, 0.45);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 2.5rem;
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    transition: border-color 0.4s var(--ease-out), box-shadow 0.4s var(--ease-out), background 0.4s var(--ease-out);
    transform-style: preserve-3d;
    backface-visibility: hidden;
    overflow: hidden;
  }

  .about-block:hover {
    background: rgba(13, 15, 23, 0.6);
    border-color: rgba(255, 255, 255, 0.18);
    box-shadow: 0 15px 40px rgba(0, 0, 0, 0.4);
  }

  .block-border-accent {
    position: absolute;
    top: 6px;
    left: 6px;
    right: 6px;
    bottom: 6px;
    border: 1px solid rgba(255, 255, 255, 0.03);
    border-radius: 12px;
    pointer-events: none;
  }

  .block-tag {
    font-family: monospace;
    font-size: 0.65rem;
    color: var(--text-dim);
    letter-spacing: 0.08em;
    font-weight: bold;
    margin-bottom: 1rem;
    display: block;
  }

  .block-title {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: var(--text);
    margin: 0 0 1.8rem 0;
  }

  /* Block 1: Who I Am Profile Bullets */
  .profile-bullets {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
  }

  .bullet-item {
    display: flex;
    gap: 0.8rem;
    align-items: flex-start;
  }

  .bullet-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--cyan);
    box-shadow: 0 0 8px var(--cyan);
    margin-top: 6px;
    shrink: 0;
  }

  .bullet-text {
    font-family: var(--font-body);
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--text-muted);
  }

  .bullet-text strong {
    color: var(--text);
  }

  /* Block 2: How I Think Ethos Quote */
  .quote-wrapper {
    margin: 0.8rem 0 1.8rem 0;
    border-left: 2px solid var(--cyan);
    padding-left: 1.2rem;
  }

  .quote-text {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 2.5vw, 1.85rem);
    font-weight: 800;
    color: var(--text);
    line-height: 1.25;
    letter-spacing: -0.02em;
    margin: 0;
  }

  .principles-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: auto;
  }

  .principle-tag {
    font-family: monospace;
    font-size: 0.68rem;
    font-weight: bold;
    color: var(--cyan);
    background: rgba(51, 230, 255, 0.06);
    border: 1px solid rgba(51, 230, 255, 0.15);
    padding: 0.3rem 0.7rem;
    border-radius: 99px;
  }

  /* Block 3: Telemetry Box styling */
  .telemetry-box {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    background: rgba(3, 3, 5, 0.5);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 1.2rem;
    font-family: monospace;
    font-size: 0.72rem;
  }

  .telemetry-row {
    display: flex;
    justify-content: space-between;
  }

  .t-label {
    color: var(--text-dim);
  }

  .t-value {
    color: var(--text);
    font-weight: bold;
  }

  .text-cyan { color: var(--cyan); }
  .text-violet { color: var(--violet); }
  .text-green { color: var(--green); }

  /* Block 4: Future Vision List */
  .vision-grid-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .vision-item {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
  }

  .vision-num {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 800;
    color: var(--violet);
    letter-spacing: -0.05em;
    margin-top: 2px;
  }

  .vision-title {
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 800;
    color: var(--text);
    margin: 0 0 0.3rem 0;
  }

  .vision-desc {
    font-family: var(--font-body);
    font-size: 0.8rem;
    line-height: 1.45;
    color: var(--text-muted);
    margin: 0;
  }

  /* Block Accent Glows */
  .block-glow {
    position: absolute;
    width: 250px;
    height: 250px;
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.03;
    pointer-events: none;
    z-index: -1;
    transition: opacity 0.4s var(--ease-out);
  }

  .about-block:hover .block-glow {
    opacity: 0.06;
  }

  .block-who .block-glow { background: var(--cyan); top: -10%; left: -10%; }
  .block-think .block-glow { background: var(--pink); bottom: -10%; right: -10%; }
  .block-build .block-glow { background: var(--green); bottom: -10%; left: -10%; }
  .block-vision .block-glow { background: var(--violet); top: -10%; right: -10%; }

  /* Responsive Design */
  @media (max-width: 968px) {
    .about-section {
      padding: 6rem 1rem;
    }
    .about-grid {
      grid-template-columns: 1fr;
      gap: 1.8rem;
    }
    .about-block {
      padding: 1.8rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .about-block {
      transition: none !important;
    }
  }
</style>
