---
import "../styles/global.css";

import SEO from "../components/layout/SEO.astro";
import Navbar from "../components/layout/Navbar.astro";
import Footer from "../components/layout/Footer.astro";
import Preloader from "../components/global/Preloader.astro";
import BackgroundScene from "../components/global/BackgroundScene";
import Cursor from "../components/global/Cursor";
---

<html lang="en">
  <head>
    <SEO />
  </head>
  <body>
    <Preloader />
    <BackgroundScene client:load />
    <Cursor client:load />

    <Navbar />

    <main id="main-content">
      <slot />
    </main>

    <Footer />

    <script>
      import { initSmoothScroll } from "../scripts/lenis";
      import { initAnimations } from "../scripts/animations";

      const boot = () => {
        initSmoothScroll();
        initAnimations();
      };

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", boot, { once: true });
      } else {
        boot();
      }

      document.addEventListener("astro:page-load", boot);
    </script>
  </body>
</html>
